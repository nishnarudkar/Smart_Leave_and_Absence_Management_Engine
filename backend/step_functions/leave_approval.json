{
  "Comment": "Leave Approval Workflow",
  "StartAt": "Wait",
  "States": {
    "Wait": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "HR Required?"
    },
    "HR Required?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.num_days",
          "NumericGreaterThan": 5,
          "Next": "Wait For HR"
        }
      ],
      "Default": "approve_leave_request"
    },
    "Wait For HR": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "approve_leave_request"
    },
    "approve_leave_request": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:ap-south-1:020426223468:function:approve_leave_request:$LATEST"
      },
      "End": true
    }
  }
}